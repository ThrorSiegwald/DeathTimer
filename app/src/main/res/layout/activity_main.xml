<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FF1A1A2E"
    android:padding="16dp"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/statusTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Таймер не запущен"
        android:textColor="#AAAAAA"
        android:textSize="16sp"
        android:layout_marginTop="40dp" />

    <LinearLayout
        android:id="@+id/timerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_weight="1">

        <TextView
            android:id="@+id/timerTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00:00"
            android:textColor="#FFFFFF"
            android:textSize="72sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:layout_marginVertical="40dp" />

        <Button
            android:id="@+id/startButton"
            android:layout_width="250dp"
            android:layout_height="56dp"
            android:text="СТАРТ"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="#FF4CAF50"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/stopButton"
            android:layout_width="250dp"
            android:layout_height="56dp"
            android:text="СТОП"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="#FFFF5722"
            android:textColor="#FFFFFF"
            android:enabled="false"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/resetButton"
            android:layout_width="250dp"
            android:layout_height="56dp"
            android:text="СБРОС"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="#FF9E9E9E"
            android:textColor="#FFFFFF"
            android:enabled="false"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/qrScanButton"
            android:layout_width="250dp"
            android:layout_height="56dp"
            android:text="СКАНИРОВАТЬ QR"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#FF2196F3"
            android:textColor="#FFFFFF"
            android:enabled="false"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/settingsButton"
            android:layout_width="250dp"
            android:layout_height="56dp"
            android:text="НАСТРОЙКИ"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#FF673AB7"
            android:textColor="#FFFFFF" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/expiredContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:background="#CC000000">

        <TextView
            android:id="@+id/deathMessageTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ТЫ МЕРТВ"
            android:textColor="#FFFF0000"
            android:textSize="64sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:gravity="center" />

    </LinearLayout>

</LinearLayout>
